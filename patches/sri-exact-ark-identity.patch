+/// Identifies opaque account formats whose exact bytes are required by the receiver.
+/// This is an identity-preservation rule, not wallet/address validation.
+pub(crate) fn requires_exact_upstream_identity(identity: &str) -> bool {
+    identity.starts_with("sri/") || identity.starts_with("ark1") || identity.starts_with("tark1")
+}
