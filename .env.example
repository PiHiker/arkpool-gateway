# Set a reserved IPv4 address belonging to your Linux Docker host.
LAN_IP=192.168.1.10
# Allow only this private subnet without listing individual miners.
# Use the real subnet containing LAN_IP; this common example is 192.168.1.0/24.
MINER_IPS=subnet
LAN_CIDR=192.168.1.0/24
# Wider option: MINER_IPS=lan permits every RFC1918 source. Tighter option:
# use up to 16 exact comma-separated miner IPv4s. Existing settings keep working.
# Optional with an exact-IP list: pin a miner source to the SHA-256 fingerprint
# of its complete checksum-valid Ark username. Keep the mapping private.
# MINER_ACCOUNT_PINS=192.168.1.70=<64 lowercase hexadecimal characters>
# Public ArkPool Tor endpoint; already configured, no invitation required.
POOL_ONION=sj2uz24t77burdvmljhr6sjfp2ceyikmjz3gegvsokcsxzvauhq6paid.onion
POOL_PORT=3333
LAN_PORT=3333
# Optional encryption: uncomment to add TLS on port 3334 and enable pairing.
# TLS_ENABLED=1
# Optional custom TLS port (must differ from LAN_PORT when enabled).
# LAN_TLS_PORT=3334
# Optional: prefer a reliably faster Tor path for NEW connections only.
# Default remains round-robin; existing sessions never move for speed.
# TOR_ROUTE_POLICY=latency
# Keep different miners on separately isolated Tor streams. Optional values:
# session (new isolation token per connection) or shared (one token per process).
TOR_ISOLATION=miner
# Optional authenticated-dashboard field. Keep disabled unless the dashboard is
# private and the operator explicitly wants RFC1918 miner addresses displayed.
# DASHBOARD_CLIENT_IPS=1
# Optional Shhark integration. Generate a private token with `openssl rand -hex 32`
# and use compose.shhark-status.yaml; never commit or paste the resulting value.
# SHHARK_STATUS_TOKEN=<64 lowercase hexadecimal characters>
# SHHARK_STATUS_PORT=3335
